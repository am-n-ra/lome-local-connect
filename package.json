{
  "name": "omni-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "tsx server/index.ts",
    "lint": "tsc --noEmit",
    "build": "npm run build:vercel-functions && tsc -b && vite build",
    "build:vercel-functions": "node scripts/build-vercel-functions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "proof:live-seller": "node scripts/prove-v2-live-seller.mjs",
    "seed:demo": "node scripts/seed-demo-lome.mjs",
    "seed:demo:emit": "node scripts/seed-demo-lome.mjs --emit-json",
    "server": "tsx server/index.ts",
    "build:server": "tsc --noEmit",
    "dev:full": "npm run build && npm run server"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "latest",
    "fedapay": "^1.2.5",
    "jose": "^6.2.10",
    "jsqr": "^1.4.0",
    "lucide-react": "latest",
    "maplibre-gl": "^6.5.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "jsdom": "latest",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "vitest": "latest"
  }
}
