{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/auth", "destination": "/" },
    { "source": "/auth/:path*", "destination": "/" },
    { "source": "/api/v2/seller/catalogue/:id", "destination": "/api/v2/seller/catalogue?id=:id" },
    { "source": "/api/v2/seller/demo-rebind", "destination": "/api/v2/seller/catalogue?omni_action=demo-rebind" },
    { "source": "/api/v2/wallet", "destination": "/api/v2/seller/catalogue?omni_action=wallet" },
    { "source": "/api/v2/wallet/recharges", "destination": "/api/v2/seller/catalogue?omni_action=wallet-recharge" },
    { "source": "/api/v2/wallet/pro", "destination": "/api/v2/seller/catalogue?omni_action=wallet-pro" },
    { "source": "/api/v2/fedapay/webhook", "destination": "/api/v2/seller/catalogue?omni_action=fedapay-webhook" },
    { "source": "/api/v2/transaction-messages", "destination": "/api/v2/seller/catalogue?omni_action=transaction-messages" },
    { "source": "/api/v2/availability-responses", "destination": "/api/v2/availability?__path=/api/v2/availability-responses" },
    { "source": "/api/v2/:path*", "destination": "/api/v2/availability?__path=/api/v2/:path*" }
  ]
}
