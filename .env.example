# .env.example
PORT=3000
V2_DATABASE_URL=
DATABASE_URL=
NEON_AUTH_JWKS_URL=
VITE_NEON_AUTH_URL=
BLOB_READ_WRITE_TOKEN=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
ALLOWED_ORIGIN=
GEMINI_API_KEY=

# Routing (server-side only — never exposed with the VITE_ prefix).
# Mapbox Directions is the founder-chosen provider (RT-D1, 2026-09-17). Set the
# token here to activate real road itineraries.
#
# Which token: create a DEDICATED PUBLIC token (pk.), not the account's default
# public token, and not a secret (sk.) token. Mapbox states the default public
# token "is intended for use in development, and should be replaced with a new
# public token once your app is ready for deployment", and it cannot have scopes
# or URL restrictions managed. A secret token is for creating/editing account
# resources and is not needed: Directions is a read-only API.
# Scopes: leave the standard public read scopes in place. The documented public
# scopes are styles:tiles, styles:read, fonts:read (plus datasets:read and
# vision:read where available) and Directions works with a standard public
# token; I could NOT verify that a dedicated "directions" scope exists, so do not
# hunt for one. One trap if you do edit scopes: a token created with NO scopes
# cannot later be given any, so do not strip it bare.
#
# Do NOT put URL restrictions on this token. URL restrictions match the browser
# Referer/Origin header, and these calls come from a Vercel serverless function
# that sends no browser Referer — a restricted token risks 403 on every request.
# URL restrictions are not our defence anyway: the token never reaches the
# browser (verified on the built bundle), so it cannot be scraped from the client.
MAPBOX_ACCESS_TOKEN=
# Optional, and billed on a higher Mapbox tier: set to `driving-traffic` to make
# driving ETAs traffic-aware. Left unset, trips use `mapbox/driving` (no traffic).
MAPBOX_DRIVING_PROFILE=
# Alternative self-hosted engine. Only used when MAPBOX_ACCESS_TOKEN is unset.
OSRM_BASE_URL=
# RT-D1 cost control. When a BILLED provider is active (Mapbox), the routing
# endpoint requires a signed-in buyer and applies a per-buyer budget
# (60 itineraries/hour, 500/day) so a bill cannot be run up anonymously. A
# self-hosted OSRM costs nothing and keeps serving anonymous previews.
# ROUTING_ACCESS_MODE: billed (default) | always | never. Use `never` to reopen
# anonymous access during an incident.
ROUTING_ACCESS_MODE=
# Opt-in, default off. Set to 1 to also require a LIVE purchase intent (an active
# reservation whose QR has not expired). This is the founder's stricter idea.
# Warning: it removes every itinerary preview before the buyer commits, which can
# cost conversions — the budget above already bounds the spend. Turn it on
# knowingly.
ROUTING_REQUIRE_INTENT=
