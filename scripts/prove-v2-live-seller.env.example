# Copy these names into an external CI/Preview secret store.
# Do not commit real values, tokens, connection strings or user credentials.
OMNI_PROOF_ENVIRONMENT=isolated
OMNI_PROOF_BRANCH_ID=<disposable-neon-branch-id>
OMNI_PROOF_BASE_URL=https://<isolated-vercel-preview>
OMNI_PROOF_AUTH_URL=https://<branch-neonauth-host>/neondb/auth
OMNI_PROOF_DATABASE_URL=<disposable-branch-connection-string>
OMNI_PROOF_SELLER_EMAIL=<external-test-seller-email>
OMNI_PROOF_SELLER_PASSWORD=<external-test-seller-password>
OMNI_PROOF_BUYER_EMAIL=<external-test-buyer-email>
OMNI_PROOF_BUYER_PASSWORD=<external-test-buyer-password>
OMNI_PROOF_ALLOW_SIGN_UP=0
