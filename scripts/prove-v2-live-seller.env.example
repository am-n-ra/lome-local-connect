# Copy these variable names into an external CI secret store; never commit real values.
# For the approved B path, the values must all describe the persistent V2 branch and its canonical deployment.
OMNI_PROOF_ENVIRONMENT=production-connected-demo
OMNI_PROOF_ALLOW_PRODUCTION_CONNECTED=1
OMNI_PROOF_BRANCH_ID=<persistent-v2-branch-id>
OMNI_PROOF_BASE_URL=https://omni.sparkafrika.online
OMNI_PROOF_AUTH_URL=<persistent-v2-neon-auth-base-url>
OMNI_PROOF_DATABASE_URL=<persistent-v2-branch-connection-string>
OMNI_PROOF_SELLER_EMAIL=<fresh-demo-seller-email>
OMNI_PROOF_SELLER_PASSWORD=<fresh-demo-seller-password>
OMNI_PROOF_BUYER_EMAIL=<fresh-demo-buyer-email>
OMNI_PROOF_BUYER_PASSWORD=<fresh-demo-buyer-password>
OMNI_PROOF_ALLOW_SIGN_UP=0
OMNI_PROOF_REBIND_FIXTURES=1

# The values above must be entered by the operator in the external secret store.
# Never place credentials, bearer tokens, QR material, hashes or database URLs in source, logs, screenshots or evidence.
# The runner keeps credentials and bearer tokens in memory only and emits redacted status markers.
